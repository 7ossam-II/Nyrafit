{%- liquid
  assign handle = section.settings.instagram_handle | strip | remove: '@'
  assign profile_url = ''
  if handle != blank
    assign profile_url = 'https://www.instagram.com/' | append: handle | append: '/'
  endif
-%}

<div class="nayra nayra-gallery">
  <div class="nayra-wrap nayra-gallery__grid">
    <div class="nayra-gallery__head">
      <h2 class="nayra-display nayra-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="nayra-lede">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if profile_url != blank -%}
        <a class="nayra-link" href="{{ profile_url }}" target="_blank" rel="noopener">@{{ handle }}{% render 'nayra-icon', icon: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="nayra-prints">
      {%- for block in section.blocks -%}
        {%- liquid
          assign print_url = block.settings.link | default: profile_url
          assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1
          assign placeholder_name = 'collection-apparel-' | append: placeholder_index
          assign print_image = block.settings.image
          assign print_alt = print_image.alt | default: section.settings.heading | escape
        -%}
        {%- capture print -%}
          {%- if print_image != blank -%}
            {{ print_image | image_url: width: 720 | image_tag: widths: '240, 360, 480, 720', sizes: '(min-width: 750px) 18vw, 44vw', loading: 'lazy', class: 'nayra-arch__img', alt: print_alt }}
          {%- else -%}
            {% render 'nayra-placeholder', name: placeholder_name %}
          {%- endif -%}
        {%- endcapture -%}
        {%- if print_url != blank -%}
          <a class="nayra-arch nayra-print" href="{{ print_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{{ print }}</a>
        {%- else -%}
          <div class="nayra-arch nayra-print" {{ block.shopify_attributes }}>{{ print }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nayra gallery",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "La communauté Nayra"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Suis-nous sur Instagram pour les nouvelles drops."
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram account",
      "default": "nayra.fitwear",
      "info": "Without the @. Photos link to this account unless they have their own link."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "For example a post or a reel. Leave empty to link to the Instagram account."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Nayra gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
