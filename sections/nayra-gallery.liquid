{%- liquid
  assign handle = section.settings.instagram_handle | strip | remove: '@'
  assign profile_url = ''
  if handle != blank
    assign profile_url = 'https://www.instagram.com/' | append: handle | append: '/'
  endif
-%}

<div class="nayra nayra-block nayra-gallery">
  <div class="nayra-wrap">
    <div class="nayra-head">
      <div class="nayra-head__copy">
        <h2 class="nayra-display nayra-section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="nayra-lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if profile_url != blank -%}
        <a class="nayra-link" href="{{ profile_url }}" target="_blank" rel="noopener">{% render 'nayra-icon', icon: 'instagram' %}@{{ handle }}</a>
      {%- endif -%}
    </div>
  </div>
  <ul class="nayra-prints" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign print_url = block.settings.link | default: profile_url
        assign print_image = block.settings.image
        assign print_alt = print_image.alt | default: section.settings.heading | strip_html | escape
      -%}
      {%- capture print -%}
        {%- if print_image != blank -%}
          {{ print_image | image_url: width: 720 | image_tag: widths: '240, 360, 480, 720', sizes: '(min-width: 990px) 16vw, 42vw', loading: 'lazy', class: 'nayra-frame__img', alt: print_alt }}
        {%- else -%}
          {% render 'nayra-placeholder', tone: forloop.index %}
        {%- endif -%}
      {%- endcapture -%}
      <li class="nayra-print" {{ block.shopify_attributes }}>
        {%- if print_url != blank -%}
          <a class="nayra-frame nayra-print__frame" href="{{ print_url }}" target="_blank" rel="noopener">{{ print }}</a>
        {%- else -%}
          <div class="nayra-frame nayra-print__frame">{{ print }}</div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Nayra gallery",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Lebsi w tagui-na."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Suis-nous sur Instagram pour les nouvelles drops."
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram account",
      "default": "nayra.fitwear",
      "info": "Without the @. Photos link to this account unless they have their own link."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "For example a post or a reel. Leave empty to link to the Instagram account."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Nayra gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
