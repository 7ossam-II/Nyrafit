{%- liquid
  assign image = section.settings.image
  assign image_alt = image.alt | default: section.settings.heading | strip_html | escape
-%}

<div class="nayra nayra-block nayra-story{% if section.settings.image_side == 'right' %} nayra-story--flip{% endif %}">
  <div class="nayra-wrap nayra-story__grid">
    <div class="nayra-frame nayra-story__media">
      {%- if image != blank -%}
        {{ image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 990px) 44vw, 92vw', loading: 'lazy', class: 'nayra-frame__img', alt: image_alt }}
      {%- else -%}
        {% render 'nayra-placeholder', tone: 3 %}
      {%- endif -%}
    </div>
    <div class="nayra-story__copy">
      <h2 class="nayra-display nayra-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="nayra-story__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="nayra-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}{% render 'nayra-icon', icon: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nayra story",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A portrait photo works best (4:5)."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side on computers",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Nayra, dyalek."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Nayra est une marque marocaine de vêtements de sport pour femmes. Des pièces NAYRA pour bouger à l'aise, une collection modeste pour celles qui se couvrent, et des prix pensés pour toutes les gymgirls.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Notre histoire"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "For example your About page. The link hides while this is empty."
    }
  ],
  "presets": [
    {
      "name": "Nayra story"
    }
  ]
}
{% endschema %}
