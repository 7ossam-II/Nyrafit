{%- liquid
  assign source = section.settings.collection
  assign limit = section.settings.products_to_show
  assign size_name = section.settings.size_option | downcase | strip

  assign has_products = false
  if source != blank and source.products_count > 0
    assign has_products = true
  endif

  assign total = 4
  if has_products
    assign total = source.products_count | at_most: limit
    assign first_product = source.products.first
  endif

  capture whatsapp_base
    render 'whatsapp-url'
  endcapture
  if section.settings.show_whatsapp == false
    assign whatsapp_base = ''
  endif
-%}

<nayra-tbdila class="nayra nayra-stage nayra-tbdila">
  <div class="nayra-wrap nayra-head nayra-tbdila__head">
    <div class="nayra-head__copy">
      <h2 class="nayra-display nayra-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="nayra-lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="nayra-tbdila__stage">
    <div class="nayra-tbdila__floor" aria-hidden="true"></div>
    <div class="nayra-rail" data-rail>
      {%- if has_products -%}
        {%- for product in source.products limit: limit -%}
          {% render 'nayra-look', product: product, size_name: size_name, first: forloop.first, index: forloop.index %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {% render 'nayra-look', first: forloop.first, index: i %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="nayra-steer">
      <button class="nayra-ring nayra-steer__btn" type="button" data-prev aria-label="{{ 'content.nayra.previous' | t }}">{% render 'nayra-icon', icon: 'prev' %}</button>
      <button class="nayra-ring nayra-steer__btn" type="button" data-next aria-label="{{ 'content.nayra.next' | t }}">{% render 'nayra-icon', icon: 'next' %}</button>
    </div>

    {% render 'nayra-ticket', product: first_product, size_name: size_name, total: total, whatsapp_base: whatsapp_base %}
  </div>
</nayra-tbdila>

{% schema %}
{
  "name": "Nayra tbdila",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Hadi hiya l'outfit"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Glisse pour voir chaque tenue, choisis ta taille et commande."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "The outfits shown one by one. Use the collection of your latest drop."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of outfits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "size_option",
      "label": "Size option name",
      "default": "Taille",
      "info": "The product option shown as size buttons in the ticket."
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show \"Order on WhatsApp\" in the ticket",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Nayra tbdila"
    }
  ]
}
{% endschema %}
