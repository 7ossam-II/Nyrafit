{%- liquid
  assign image = section.settings.image
  assign image_alt = image.alt | default: section.settings.heading | strip_html | escape

  assign button_url = section.settings.button_link
  assign opens_whatsapp = false
  if button_url == blank and section.settings.whatsapp_message != blank
    capture button_url
      render 'whatsapp-url', message: section.settings.whatsapp_message
    endcapture
    assign opens_whatsapp = true
    if button_url == blank and request.design_mode
      assign button_url = '#'
    endif
  endif

  assign button_class = 'nayra-btn--blush'
  if section.settings.color == 'blush'
    assign button_class = 'nayra-btn--onyx'
  endif
-%}

<div class="nayra nayra-banner nayra-banner--{{ section.settings.color }}{% if section.settings.show_image %} nayra-banner--image{% endif %}">
  <svg class="nayra-banner__zellige" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="NayraZellige-{{ section.id }}" width="64" height="64" patternUnits="userSpaceOnUse">
        <path d="M32 6l7.6 18.4L58 32l-18.4 7.6L32 58l-7.6-18.4L6 32l18.4-7.6z" fill="none" stroke="currentColor" stroke-width="1"/>
        <path d="M14 14h36v36H14z" fill="none" stroke="currentColor" stroke-width="1" transform="rotate(45 32 32)"/>
        <circle cx="32" cy="32" r="4" fill="none" stroke="currentColor" stroke-width="1"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#NayraZellige-{{ section.id }})"/>
  </svg>

  <div class="nayra-wrap nayra-banner__grid">
    <div class="nayra-banner__copy">
      <h2 class="nayra-display nayra-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="nayra-lede">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and button_url != blank -%}
        <div class="nayra-actions">
          <a
            class="nayra-btn {{ button_class }}"
            href="{{ button_url }}"
            {% if opens_whatsapp %}
              target="_blank" rel="noopener"
            {% endif %}
          >
            {%- if opens_whatsapp -%}{{ 'icon-whatsapp.svg' | inline_asset_content }}{%- endif -%}
            {{- section.settings.button_label -}}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_image -%}
      <div class="nayra-banner__media">
        <div class="nayra-frame nayra-banner__frame">
          {%- if image != blank -%}
            {{ image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 34vw, 88vw', loading: 'lazy', class: 'nayra-frame__img', alt: image_alt }}
          {%- else -%}
            {% render 'nayra-placeholder', tone: 1 %}
          {%- endif -%}
        </div>
        {%- if section.settings.badge != blank -%}
          <span class="nayra-badge nayra-badge--onyx nayra-banner__badge">{% render 'nayra-icon', icon: 'sparkle' %}{{ section.settings.badge }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Nayra banner",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        { "value": "blush", "label": "Blush" },
        { "value": "raised", "label": "Onyx" },
        { "value": "deep", "label": "Black" }
      ],
      "default": "blush",
      "info": "Colors come from Theme settings > Nayra style."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Mestoura w zwina."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "La collection modeste arrive\u00a0: burkinis et pièces couvrantes pour t'entraîner et nager à l'aise."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Me prévenir sur WhatsApp"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to open WhatsApp with the message below."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp message",
      "default": "Salam, préviens-moi pour la collection modeste."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on the image",
      "default": "Bientôt",
      "visible_if": "{{ section.settings.show_image }}"
    }
  ],
  "presets": [
    {
      "name": "Nayra banner"
    }
  ]
}
{% endschema %}
