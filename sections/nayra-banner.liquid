{%- liquid
  assign image = section.settings.image
  assign image_alt = image.alt | default: section.settings.heading | escape

  assign button_url = section.settings.button_link
  assign opens_whatsapp = false
  if button_url == blank and section.settings.whatsapp_message != blank
    capture button_url
      render 'whatsapp-url', message: section.settings.whatsapp_message
    endcapture
    assign opens_whatsapp = true
    if button_url == blank and request.design_mode
      assign button_url = '#'
    endif
  endif
-%}

<div class="nayra nayra-banner">
  <div class="nayra-wrap">
    <div class="nayra-banner__card nayra-banner--{{ section.settings.color }}{% if section.settings.show_image %} nayra-banner__card--image{% endif %}">
      <svg class="nayra-banner__zellige" aria-hidden="true" focusable="false">
        <defs>
          <pattern id="NayraZellige-{{ section.id }}" width="56" height="56" patternUnits="userSpaceOnUse">
            <path d="M28 6l6.4 15.6L50 28l-15.6 6.4L28 50l-6.4-15.6L6 28l15.6-6.4z" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12.4 12.4h31.2v31.2H12.4z" fill="none" stroke="currentColor" stroke-width="1.5" transform="rotate(45 28 28)"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#NayraZellige-{{ section.id }})"/>
      </svg>

      <div class="nayra-banner__copy">
        <h2 class="nayra-display nayra-section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="nayra-lede">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank and button_url != blank -%}
          <div class="nayra-actions">
            <a
              class="nayra-btn nayra-btn--light"
              href="{{ button_url }}"
              {% if opens_whatsapp %}
                target="_blank" rel="noopener"
              {% endif %}
            >
              {%- if opens_whatsapp -%}{{ 'icon-whatsapp.svg' | inline_asset_content }}{%- endif -%}
              {{- section.settings.button_label -}}
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_image -%}
        <div class="nayra-banner__media">
          <div class="nayra-arch nayra-banner__arch">
            {%- if image != blank -%}
              {{ image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 26rem, 70vw', loading: 'lazy', class: 'nayra-arch__img', alt: image_alt }}
            {%- else -%}
              {% render 'nayra-placeholder', tone: 2 %}
            {%- endif -%}
          </div>
          {%- if section.settings.sticker != blank -%}
            <p class="nayra-sticker nayra-sticker--pink nayra-banner__sticker">{{ section.settings.sticker }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nayra banner",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        { "value": "field", "label": "Banner background" },
        { "value": "pink", "label": "Pink" },
        { "value": "sun", "label": "Yellow" },
        { "value": "stage", "label": "Plum" }
      ],
      "default": "field",
      "info": "Colors come from Theme settings > Nayra style."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "La collection modeste arrive"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Burkinis et pièces couvrantes, pensés pour s'entraîner et nager à l'aise."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Me prévenir sur WhatsApp"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to open WhatsApp with the message below."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp message",
      "default": "Salam, préviens-moi pour la collection modeste."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "text",
      "id": "sticker",
      "label": "Sticker on the image",
      "default": "Bientôt",
      "visible_if": "{{ section.settings.show_image }}"
    }
  ],
  "presets": [
    {
      "name": "Nayra banner"
    }
  ]
}
{% endschema %}
