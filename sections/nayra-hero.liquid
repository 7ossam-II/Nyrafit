{%- liquid
  assign heading_tag = 'h2'
  if template.name == 'index'
    assign heading_tag = 'h1'
  endif

  assign image = section.settings.image
  assign image_alt = image.alt | default: section.settings.heading | strip_html | escape

  assign whatsapp_url = ''
  if section.settings.whatsapp_label != blank
    capture whatsapp_url
      render 'whatsapp-url', message: section.settings.whatsapp_message
    endcapture
    if whatsapp_url == blank and request.design_mode
      assign whatsapp_url = '#'
    endif
  endif
-%}

<div class="nayra nayra-hero">
  <div class="nayra-wrap nayra-hero__grid">
    <{{ heading_tag }} class="nayra-display nayra-hero__title">{{ section.settings.heading }}</{{ heading_tag }}>

    <div class="nayra-hero__media{% if image != blank or request.design_mode %} nayra-hero__media--photo{% endif %}">
      <nayra-satin class="nayra-arch nayra-hero__satin"{% if section.settings.animate == false %} data-still{% endif %}>
        <canvas class="nayra-satin__canvas" aria-hidden="true"></canvas>
      </nayra-satin>
      {%- if image != blank -%}
        <div class="nayra-arch nayra-hero__photo">
          {{ image | image_url: width: 1000 | image_tag: widths: '300, 400, 600, 800, 1000', sizes: '(min-width: 990px) 24vw, 52vw', loading: 'eager', fetchpriority: 'high', class: 'nayra-arch__img', alt: image_alt }}
        </div>
      {%- elsif request.design_mode -%}
        <div class="nayra-arch nayra-hero__photo">{% render 'nayra-placeholder', tone: 5 %}</div>
      {%- endif -%}
      {%- if section.settings.sticker_top != blank -%}
        <p class="nayra-sticker nayra-sticker--pink nayra-hero__sticker-top">{{ section.settings.sticker_top }}</p>
      {%- endif -%}
      {%- if section.settings.sticker_bottom != blank -%}
        <p class="nayra-sticker nayra-sticker--sun nayra-hero__sticker-bottom">{% render 'nayra-icon', icon: 'check' %}{{ section.settings.sticker_bottom }}</p>
      {%- endif -%}
    </div>

    <div class="nayra-hero__copy">
      {%- if section.settings.text != blank -%}
        <p class="nayra-lede">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="nayra-actions">
        {%- if section.settings.button_label != blank -%}
          <a class="nayra-btn nayra-btn--pink" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label -}}
            {%- render 'nayra-icon', icon: 'arrow' -%}
          </a>
        {%- endif -%}
        {%- if whatsapp_url != blank -%}
          <a class="nayra-btn nayra-btn--ghost" href="{{ whatsapp_url }}" target="_blank" rel="noopener">
            {{- 'icon-whatsapp.svg' | inline_asset_content -}}
            {{- section.settings.whatsapp_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nayra hero",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Lebsa <em>jdida</em> l'salle.",
      "info": "Put a word in italics to highlight it in yellow."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Sets, leggings et combis pour t'entraîner à l'aise."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Voir la collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "Commander sur WhatsApp",
      "info": "Shown when a WhatsApp number is set in Theme settings."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp message",
      "default": "Salam, je veux commander."
    },
    {
      "type": "header",
      "content": "Satin and photo"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate the satin",
      "default": true,
      "info": "The satin always stays still for visitors who turn motion off on their phone."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Shown in an arch over the satin. Portrait photos work best."
    },
    {
      "type": "header",
      "content": "Stickers"
    },
    {
      "type": "text",
      "id": "sticker_top",
      "label": "Pink sticker",
      "default": "Nouvelle drop"
    },
    {
      "type": "text",
      "id": "sticker_bottom",
      "label": "Yellow sticker",
      "default": "Paiement à la livraison"
    }
  ],
  "presets": [
    {
      "name": "Nayra hero"
    }
  ]
}
{% endschema %}
