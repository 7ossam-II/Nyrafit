<div class="nayra nayra-block nayra-collections">
  <div class="nayra-wrap">
    <div class="nayra-head">
      <div class="nayra-head__copy">
        <h2 class="nayra-display nayra-section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="nayra-lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>
    <ul class="nayra-tiles" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          assign tile_label = block.settings.label | default: tile_collection.title
          assign tile_url = tile_collection.url | default: routes.collections_url
          assign tile_image = block.settings.image | default: tile_collection.featured_image
          assign tile_alt = tile_image.alt | default: tile_label | escape
          assign tile_sizes = '(min-width: 990px) 31vw, 46vw'
          if block.settings.wide
            assign tile_sizes = '(min-width: 990px) 63vw, 92vw'
          endif
        -%}
        <li class="nayra-tile{% if block.settings.wide %} nayra-tile--wide{% endif %}" {{ block.shopify_attributes }}>
          <a class="nayra-tile__link" href="{{ tile_url }}">
            <span class="nayra-frame nayra-tile__media">
              {%- if tile_image != blank -%}
                {{ tile_image | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 1000, 1400', sizes: tile_sizes, loading: 'lazy', class: 'nayra-frame__img', alt: tile_alt }}
              {%- else -%}
                {% render 'nayra-placeholder', tone: forloop.index %}
              {%- endif -%}
            </span>
            <span class="nayra-tile__label">
              <span class="nayra-display nayra-tile__name">{{ tile_label }}</span>
              <span class="nayra-ring nayra-tile__go">{% render 'nayra-icon', icon: 'arrow' %}</span>
            </span>
          </a>
          {%- if block.settings.badge != blank -%}
            <span class="nayra-badge nayra-badge--pearl nayra-tile__badge">{% render 'nayra-icon', icon: 'sparkle' %}{{ block.settings.badge }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Nayra collections",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Khtari style dyalek"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Leave empty to use the collection's name."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use the collection's image."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Small label such as \"Bientôt\" or \"Nouveau\"."
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "Wide tile",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Nayra collections",
      "blocks": [
        { "type": "tile", "settings": { "label": "Ensembles" } },
        { "type": "tile", "settings": { "label": "Leggings" } },
        { "type": "tile", "settings": { "label": "Brassières & tops" } },
        { "type": "tile", "settings": { "label": "Combis" } },
        { "type": "tile", "settings": { "label": "Modeste", "badge": "Bientôt", "wide": true } }
      ]
    }
  ]
}
{% endschema %}
