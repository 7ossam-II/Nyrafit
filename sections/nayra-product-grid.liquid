{%- liquid
  assign source = section.settings.collection
  assign limit = section.settings.products_to_show

  assign has_products = false
  if source != blank and source.products_count > 0
    assign has_products = true
  endif

  assign view_all_url = source.url | default: routes.all_products_collection_url
-%}

<div class="nayra nayra-products">
  <div class="nayra-wrap">
    <div class="nayra-head-row">
      <h2 class="nayra-display nayra-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="nayra-link" href="{{ view_all_url }}">{{ section.settings.link_label }}{% render 'nayra-icon', icon: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="nayra-grid">
      {%- if has_products -%}
        {%- for product in source.products limit: limit -%}
          {% render 'nayra-card', product: product, index: forloop.index, show_tag: section.settings.show_tag %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {% render 'nayra-card', index: i %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nayra product grid",
  "tag": "section",
  "class": "nayra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Les favoris de la salle"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "\"View all\" link label",
      "default": "Tout voir"
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Show product type as a sticker",
      "default": true,
      "info": "Products on sale always show a sale sticker."
    }
  ],
  "presets": [
    {
      "name": "Nayra product grid"
    }
  ]
}
{% endschema %}
