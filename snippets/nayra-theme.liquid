{% doc %}
  Loads the Nayra brand tokens, stylesheet and script.
  Page background and text come from the theme's color palette, fonts from Typography,
  and the accents from the "Nayra style" settings.

  @example
  {% render 'nayra-theme' %}
{% enddoc %}

{%- liquid
  assign scheme = 'light'
  assign ground_brightness = settings.color_palette.background | color_brightness
  if ground_brightness < 128
    assign scheme = 'dark'
  endif
-%}

{% style %}
  :root {
    --nayra-ink: var(--color-foreground);
    --nayra-ground: var(--color-background);
    --nayra-blush: {{ settings.nayra_blush }};
    --nayra-blush-ink: {{ settings.nayra_blush_ink }};
    --nayra-rose: {{ settings.nayra_rose }};
    --nayra-silver: {{ settings.nayra_silver }};
    --nayra-raised: {{ settings.nayra_raised }};
    --nayra-deep: {{ settings.nayra_deep }};
    --nayra-display: var(--font-heading--family);
    --nayra-text: var(--font-body--family);
    --nayra-out: cubic-bezier(0.16, 1, 0.3, 1);
    color-scheme: {{ scheme }};
  }

  ::selection {
    background: var(--nayra-blush);
    color: var(--nayra-blush-ink);
  }

  html {
    accent-color: var(--nayra-blush);
    caret-color: var(--nayra-blush);
    scrollbar-color: var(--nayra-silver) var(--color-background);
  }
{% endstyle %}

<script>
  document.documentElement.classList.add('nayra-js');
</script>
{{ 'nayra.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nayra.js' | asset_url }}" defer></script>
