{% doc %}
  Renders one outfit on the Nayra stage: the photo, the silver frame drawn around the selected one, and the data the order ticket reads.

  @param {product} [product] - The product to show; leave empty to show a placeholder
  @param {string} [size_name] - Lowercase name of the option shown as size buttons
  @param {boolean} [first] - Whether this outfit starts selected
  @param {number} index - Position in the rail, used to vary the placeholder image

  @example
  {% render 'nayra-look', product: product, size_name: 'taille', first: forloop.first, index: forloop.index %}
{% enddoc %}

{%- liquid
  assign size_index = 0
  assign has_sizes = false
  if product != blank
    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name == size_name or option_name == 'taille' or option_name == 'size'
        assign size_index = forloop.index0
        assign has_sizes = true
      endif
    endfor
    assign media_alt = product.featured_media.alt | default: product.title | escape
  endif
-%}

<figure class="nayra-look{% if first %} is-on{% endif %}" data-look>
  <div class="nayra-look__turn">
    {%- if product != blank -%}
      <a class="nayra-frame nayra-look__frame" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 20vw, 66vw', loading: 'lazy', class: 'nayra-frame__img', alt: media_alt }}
        {%- else -%}
          {% render 'nayra-placeholder', tone: index %}
        {%- endif -%}
      </a>
    {%- else -%}
      <div class="nayra-frame nayra-look__frame">
        {% render 'nayra-placeholder', tone: index %}
      </div>
    {%- endif -%}
    {% render 'nayra-thread' %}
  </div>
  <script type="application/json" data-look-data>
    {%- if product != blank -%}
      {
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "sizeIndex": {{ size_index }},
        "selected": {{ product.selected_or_first_available_variant.id | json }},
        "variants": [
          {%- for variant in product.variants -%}
            {"id": {{ variant.id }}, "options": {{ variant.options | json }}, "available": {{ variant.available | json }}, "price": {{ variant.price | money | strip_html | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "sizes": [
          {%- if has_sizes -%}
            {%- for value in product.options_with_values[size_index].values -%}
              {{ value.name | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          {%- endif -%}
        ]
      }
    {%- else -%}
      {"placeholder": true}
    {%- endif -%}
  </script>
</figure>
