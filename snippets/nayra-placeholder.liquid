{% doc %}
  Renders a satin swatch that fills a Nayra frame until a photo is added in the Shopify admin.
  In the theme editor it also says where the photo goes.

  @param {number} tone - Position in a list, used to rotate the swatch tones

  @example
  {% render 'nayra-placeholder', tone: forloop.index %}
{% enddoc %}

{%- liquid
  assign tone_index = tone | default: 1 | minus: 1 | modulo: 5
  assign tones = 'satin,rose,smoke,dusk,pearl' | split: ','
  assign tone_name = tones[tone_index]
-%}

<span class="nayra-swatch nayra-swatch--{{ tone_name }}" aria-hidden="true">
  {%- render 'nayra-icon', icon: 'hanger' -%}
  {%- if request.design_mode -%}
    <span class="nayra-swatch__label">{{ 'content.nayra.add_photo' | t }}</span>
  {%- endif -%}
</span>
