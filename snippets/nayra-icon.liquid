{% doc %}
  Renders one of the Nayra line icons, drawn in one thin stroke to match the silver of the logo.

  @param {string} icon - One of: check, plus, prev, next, arrow, sparkle, pause, play, hanger, cash, truck, chat, instagram, heart

  @example
  {% render 'nayra-icon', icon: 'cash' %}
{% enddoc %}

{%- case icon -%}
  {%- when 'check' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
  {%- when 'plus' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5.5v13M5.5 12h13"/></svg>
  {%- when 'prev' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
  {%- when 'next' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'arrow' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8"/></svg>
  {%- when 'sparkle' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 1c.5 6.2 4.8 10.5 11 11-6.2.5-10.5 4.8-11 11-.5-6.2-4.8-10.5-11-11 6.2-.5 10.5-4.8 11-11z"/></svg>
  {%- when 'pause' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><rect x="7" y="5.5" width="3" height="13" rx="1"/><rect x="14" y="5.5" width="3" height="13" rx="1"/></svg>
  {%- when 'play' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8.5 6.2v11.6a.9.9 0 0 0 1.37.77l9.3-5.8a.9.9 0 0 0 0-1.54l-9.3-5.8a.9.9 0 0 0-1.37.77z"/></svg>
  {%- when 'hanger' -%}
    <svg class="nayra-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.5 12.5a3.5 3.5 0 1 1 4.6 3.3c-.7.3-1.1.9-1.1 1.6V20"/><path d="M24 20L6.8 32.6c-1.2.9-.6 2.9.9 2.9h32.6c1.5 0 2.1-2 .9-2.9L24 20z"/></svg>
  {%- when 'cash' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/></svg>
  {%- when 'truck' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 16.5V6.5H2.5v10h2"/><path d="M14 9.5h3.6l3.9 4v3H19"/><path d="M9.5 16.5H14"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
  {%- when 'chat' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.2 19.8l1.2-3.6A8.2 8.2 0 1 1 8.6 19z"/><path d="M8.8 12h.01M12 12h.01M15.2 12h.01"/></svg>
  {%- when 'instagram' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.2 6.8h.01"/></svg>
  {%- when 'heart' -%}
    <svg class="nayra-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7.5-4.4-7.5-10.1A4.4 4.4 0 0 1 12 7.3a4.4 4.4 0 0 1 7.5 2.6C19.5 15.6 12 20 12 20z"/></svg>
{%- endcase -%}
